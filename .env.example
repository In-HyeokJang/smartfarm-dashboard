# ==============================================================
# .env.example - GitHub에 올라가는 환경변수 템플릿 파일
# ==============================================================
# 사용법:
#   1. 이 파일을 복사하여 .env 파일 생성 (cp .env.example .env)
#   2. .env 파일에 실제 값 입력
#   3. .env 파일은 .gitignore에 등록되어 있으므로 GitHub에 올라가지 않음
# ==============================================================

# ── Neon Serverless PostgreSQL ────────────────────────────────
# 찾는 방법: Neon 대시보드 → 프로젝트 선택 → Dashboard → Connection string
# Driver: JDBC, 복사한 URL을 그대로 붙여넣으면 됩니다.
NEON_JDBC_URL=jdbc:postgresql://ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
NEON_USER=neondb_owner
NEON_PASSWORD=

# ── 관리자 계정 (대시보드 로그인) ───────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Arduino 시리얼 포트 ────────────────────────────────────────
# Windows: COM3, COM4 등 (Arduino IDE → Tools → Port 에서 확인)
# Mac/Linux: /dev/ttyUSB0 또는 /dev/ttyACM0
SERIAL_PORT=COM3
# false: 시뮬레이션 모드 (Arduino 없이 테스트), true: 실제 Arduino 연결
SERIAL_ENABLED=false